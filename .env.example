# Copia este archivo como ".env" y ajusta tus credenciales de MySQL.
# El archivo ".env" NO se sube a GitHub (está en .gitignore).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password
DB_NAME=zimbra2
DB_POOL_SIZE=5

# Solo si publicas el frontend en otro dominio (separado por comas). Si no, déjalo vacío.
CORS_ORIGINS=
